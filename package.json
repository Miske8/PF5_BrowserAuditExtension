{
  "name": "a11y-lens",
  "private": true,
  "version": "0.1.0",
  "description": "A11y Lens — extension de navigateur (Manifest V3) pour auditer l'accessibilité des pages web.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chrome": "^0.0.323",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.14.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.6.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
