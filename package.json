{
  "name": "a11y-lens",
  "private": true,
  "version": "0.1.0",
  "description": "A11y Lens — extension de navigateur (Manifest V3) pour auditer l'accessibilité des pages web.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "manifest": "node scripts/generate-manifest.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run typecheck && npm run manifest && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "package": "npm run build && node scripts/package-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.323",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.14.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.6.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "axe-core": "^4.14.0"
  }
}
